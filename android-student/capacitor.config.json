{
  "appId": "in.bitesite.app",
  "appName": "BiteSite",
  "webDir": "www",
  "server": {
    "url": "https://bitesite-app.azurewebsites.net",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#F9F9F9"
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
