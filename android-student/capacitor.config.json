{
  "appId": "in.bitesite.app",
  "appName": "BiteSite",
  "webDir": "www",
  "server": {
    "url": "https://app.bitesite.in",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#f2ead9",
      "launchShowDuration": 0
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}